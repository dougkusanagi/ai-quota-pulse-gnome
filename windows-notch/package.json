{
  "name": "ai-quota-notch",
  "version": "0.1.0",
  "private": true,
  "description": "Indicador discreto estilo notch para limites do Claude e Codex no Windows",
  "main": "src/main.js",
  "type": "commonjs",
  "scripts": {
    "start": "electron .",
    "demo": "electron . --demo",
    "demo:multi": "electron . --demo=2",
    "test": "bun test",
    "dist": "electron-builder --win --x64",
    "icon": "python3 scripts/make-icon.py"
  },
  "trustedDependencies": [
    "electron"
  ],
  "devDependencies": {
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "br.com.guepardosys.aiquotanotch",
    "productName": "AI Quota Notch",
    "directories": {
      "output": "out"
    },
    "files": [
      "src/**",
      "assets/**",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false
    }
  }
}
